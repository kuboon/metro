{
  "workspace": ["./web/client", "./web/server"],
  "tasks": {
    "dev": "deno task --cwd web/server dev",
    "serve": "deno task --cwd web/server serve",
    "build": "deno task --cwd web/server build",
    "test": "deno test -P",
    "check": "deno task --cwd web/client check && deno task --cwd web/server check && deno lint && deno fmt --check"
  },
  "permissions": {
    "default": {
      "read": true,
      "env": true,
      "import": true
    }
  },
  "test": {
    "permissions": "default"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@remix-kbn/*",
      "npm:@remix-run/*"
    ]
  },
  "unstable": ["bundle"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "imports": {
    "@remix-kbn/assets-deno": "jsr:@remix-kbn/assets-deno@^0.9.0",
    "@remix-kbn/ssg": "jsr:@remix-kbn/ssg@^0.13.0",
    "@remix-run/component": "npm:@remix-run/component@^1.3.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^1.0.1",
    "@remix-run/render-middleware": "npm:@remix-run/render-middleware@^1.1.1",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "fmt": { "exclude": ["web/dist", "node_modules"] },
  "lint": { "exclude": ["web/dist", "node_modules"] }
}
